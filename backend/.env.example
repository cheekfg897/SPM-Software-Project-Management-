# Copy to backend/.env and adjust. Never commit the real .env.

# --- Flask ---------------------------------------------------------------
FLASK_APP=wsgi
FLASK_ENV=development            # development | testing | production
SECRET_KEY=change-me-flask-secret

# --- JWT -----------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600   # 1 hour

# --- Password policy -----------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- PostgreSQL ----------------------------------------------------------
# Consumed by BOTH the postgres container (docker-compose.yml) and the backend.
POSTGRES_USER=connectsphere
POSTGRES_PASSWORD=connectsphere-dev-password
POSTGRES_DB=connectsphere
POSTGRES_HOST=localhost          # docker-compose overrides this to "postgres" for the backend container
POSTGRES_PORT=5432

# Optional: a full URL takes precedence over the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg2://connectsphere:connectsphere-dev-password@localhost:5432/connectsphere
